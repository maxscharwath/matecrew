{
  "name": "matecrew",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:cf": "PLATFORM=cloudflare next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migration": "bun scripts/db/new-migration.ts",
    "db:migrate:local": "wrangler d1 migrations apply matecrew --local",
    "db:migrate:sqlite": "bun scripts/db/migrate-sqlite.ts",
    "seed": "bun prisma/seed.ts",
    "postinstall": "prisma generate",
    "preview": "PLATFORM=cloudflare opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "PLATFORM=cloudflare opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "build:cloudflare": "bunx bun@1.4.2 install --frozen-lockfile && PLATFORM=cloudflare opennextjs-cloudflare build",
    "cf-typegen": "wrangler types cloudflare-env.d.ts --env-interface CloudflareEnv --env-file=.dev.vars.example",
    "dui": "bun device/sdk/cli/index.ts",
    "device:preview": "bun dui build && cargo run --manifest-path device/sim/Cargo.toml"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@modelcontextprotocol/server": "^2.0.0",
    "@next/mdx": "^16.3.0",
    "@prisma/adapter-d1": "^7.4.2",
    "@prisma/adapter-libsql": "7.4.2",
    "@prisma/client": "^7.4.2",
    "@react-pdf/renderer": "^4.3.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/rapier": "^2.2.0",
    "better-auth": "^1.5.1",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.577.0",
    "mcp-handler": "^2.1.0",
    "next": "16.3.8",
    "next-intl": "^4.8.3",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-chartjs-2": "^5.3.1",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.3",
    "react-pdf-tailwind": "^3.0.0",
    "recharts": "2.15.4",
    "resend": "^6.10.0",
    "server-only": "^0.0.1",
    "sharp": "0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "three": "^0.185.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1000.0",
    "@iconify-json/pixelarticons": "1.2.10",
    "@iconify-json/streamline-pixel": "1.2.0",
    "@matecrew/device-ui": "workspace:*",
    "@opennextjs/cloudflare": "^1.20.10",
    "@react-pdf/types": "2.9.2",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.4.2",
    "@types/mdx": "2.0.14",
    "@types/node": "^20",
    "@types/pg": "^8.18.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "@vercel/blob": "^2.3.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-sonarjs": "^4.2.2",
    "pg": "^8.19.0",
    "prisma": "^7.4.2",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "wrangler": "^4.149.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@prisma/engines",
    "prisma",
    "sharp",
    "unrs-resolver"
  ],
  "workspaces": [
    "device/sdk"
  ]
}
