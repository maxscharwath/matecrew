generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────

enum Role {
  USER
  ADMIN
}

enum RequestStatus {
  REQUESTED
  SERVED
  CANCELLED
}

enum ConsumptionSource {
  DAILY_REQUEST
  MANUAL
  /// Recorded by a badge terminal (see `Device`).
  DEVICE
}

/// What a badge terminal key does with its item.
enum DeviceKeyAction {
  /// Take one can: a consumption entry and one unit out of stock.
  TAKE
  /// Give one back: cancels the badge holder's latest take of that item today.
  RETURN
}

enum StockMovementReason {
  SERVED
  UNSERVED
  ADJUSTMENT
  PURCHASE
  /// Gap found by a physical stock count. Unlike ADJUSTMENT — which only
  /// repairs bookkeeping and is free — an INVENTORY delta moves money: the
  /// missing cans are billed to the period's drinkers so the buyer is not the
  /// one absorbing the shrinkage.
  INVENTORY
}

enum PurchaseStatus {
  ORDERED
  DELIVERED
}

enum PaymentStatus {
  PENDING
  PAID
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Better Auth models ─────────────────────────────────

model User {
  id              String     @id @default(cuid())
  name            String
  email           String     @unique
  emailVerified   Boolean    @default(false)
  image           String?
  locale          String     @default("fr")
  slackUserId     String?    @unique
  defaultOfficeId String?
  defaultOffice   Office?    @relation("DefaultOffice", fields: [defaultOfficeId], references: [id], onDelete: SetNull)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  flipScore       FlipScore?

  sessions Session[]
  accounts Account[]

  // OAuth provider relations (MCP connectors)
  oauthApplications OauthApplication[]
  oauthAccessTokens OauthAccessToken[]
  oauthConsents     OauthConsent[]

  articleReads ArticleRead[]

  // App relations
  memberships         Membership[]
  joinRequests        JoinRequest[]
  dailyRequests       DailyRequest[]
  consumptionEntries  ConsumptionEntry[]
  orderedBatches      PurchaseBatch[]     @relation("OrderedBy")
  paidBatches         PurchaseBatch[]     @relation("PaidBy")
  reimbursementsFrom  ReimbursementLine[] @relation("ReimbursementFrom")
  reimbursementsTo    ReimbursementLine[] @relation("ReimbursementTo")
  stockMovements      StockMovement[]
  stockCounts         StockCount[]        @relation("CountedBy")
  statementDeliveries StatementDelivery[]
  badges              Badge[]
  devicesLinked       Device[]            @relation("DeviceLinkedBy")
  deviceLinksApproved DeviceLink[]        @relation("DeviceLinkApprovedBy")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String    @id @default(cuid())
  identifier String    @unique
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt
}

// ─── OAuth 2.1 provider (MCP connectors) ────────────────
//
// Shape is dictated by Better Auth's `mcp`/`oidc-provider` plugins — field
// names must stay exactly as they are or the adapter stops finding them.
// MateCrew is the authorization server for MCP clients (Claude Desktop,
// claude.ai) which register themselves through RFC 7591 dynamic client
// registration at /api/auth/mcp/register.

model OauthApplication {
  id           String   @id @default(cuid())
  name         String
  icon         String?
  /// JSON blob from the registration request (client_uri, software_id, ...).
  metadata     String?
  clientId     String   @unique
  /// Null for public clients (PKCE only), which is what MCP clients use.
  clientSecret String?
  /// Comma-separated list — Better Auth splits on ",".
  redirectUrls String
  type         String
  disabled     Boolean  @default(false)
  /// Null when the client registered anonymously (the usual MCP case).
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  accessTokens OauthAccessToken[]
  consents     OauthConsent[]

  @@index([userId])
}

model OauthAccessToken {
  id                    String           @id @default(cuid())
  accessToken           String           @unique
  refreshToken          String           @unique
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime
  clientId              String
  client                OauthApplication @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId                String?
  user                  User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Space-separated granted scopes.
  scopes                String
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([clientId])
  @@index([userId])
  // A refresh grant inserts a new row rather than rotating in place, so this
  // table grows with usage — the index backs the housekeeping sweep.
  @@index([refreshTokenExpiresAt])
}

model OauthConsent {
  id           String           @id @default(cuid())
  clientId     String
  client       OauthApplication @relation(fields: [clientId], references: [clientId], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  scopes       String
  consentGiven Boolean
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([clientId])
  @@index([userId])
}

// ─── Release notes ──────────────────────────────────────

/// One row per (user, article) once that user has read it. Absence means unread,
/// so a newly published article is unread for everyone without a backfill, and a
/// user created later doesn't inherit a pile of "read" rows.
///
/// `slug` deliberately has no foreign key: articles are MDX files in the repo,
/// not database rows. A slug that no longer exists is simply ignored when the
/// unread count is computed against the current catalogue.
model ArticleRead {
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug   String
  readAt DateTime @default(now())

  @@id([userId, slug])
  @@index([userId])
}

// ─── App models ─────────────────────────────────────────

model Office {
  id                String  @id @default(cuid())
  name              String  @unique
  timezone          String  @default("Europe/Zurich")
  locale            String  @default("fr")
  slackChannelId    String?
  slackChannelLabel String?
  lowStockThreshold Int     @default(30)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships          Membership[]
  joinRequests         JoinRequest[]
  defaultForUsers      User[]                @relation("DefaultOffice")
  dailyRequests        DailyRequest[]
  items                Item[]
  stock                Stock[]
  purchaseBatches      PurchaseBatch[]
  consumptionEntries   ConsumptionEntry[]
  reimbursementPeriods ReimbursementPeriod[]
  mateSessions         MateSession[]
  stockCounts          StockCount[]
  devices              Device[]
  badges               Badge[]
  deviceLinks          DeviceLink[]
}

/// A consumable managed per office (e.g. "Maté Classic", "Maté Zero", "Ginger").
/// Stock, requests, consumption and purchases are all scoped to an item.
model Item {
  id                String   @id @default(cuid())
  officeId          String
  office            Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  name              String
  imageKey          String?
  active            Boolean  @default(true)
  isDefault         Boolean  @default(false)
  sortOrder         Int      @default(0)
  /// Hex colour ("#3987e5") an admin picked for this item's charts. Null lets
  /// the chart palette assign one by rank, which is what every item does until
  /// someone insists that the ginger one be orange.
  color             String?
  /// When this item's own pool dips to or below this, the low-stock alert
  /// fires for it. Null means the item follows the office's threshold, which
  /// is what every item does until someone gives it a number of its own — a
  /// rarely-drunk flavour needs a far lower floor than the house maté.
  lowStockThreshold Int?
  // Per-unit nutrition facts, used by the stats screen (defaults ≈ a 50cl maté).
  volumeMl          Int      @default(500)
  sugarGrams        Float    @default(25)
  caffeineMg        Float    @default(100)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  stock              Stock[]
  stockMovements     StockMovement[]
  dailyRequests      DailyRequest[]
  consumptionEntries ConsumptionEntry[]
  purchaseLines      PurchaseLine[]
  stockCountLines    StockCountLine[]
  devicesLeftKey     Device[]           @relation("DeviceLeftItem")
  devicesRightKey    Device[]           @relation("DeviceRightItem")

  @@unique([officeId, name])
  @@index([officeId])
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  officeId  String
  office    Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  roles     Role[]   @default([USER])
  createdAt DateTime @default(now())

  @@unique([userId, officeId])
}

model JoinRequest {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  officeId  String
  office    Office            @relation(fields: [officeId], references: [id], onDelete: Cascade)
  status    JoinRequestStatus @default(PENDING)
  createdAt DateTime          @default(now())

  @@unique([userId, officeId])
}

model MateSession {
  id                      String    @id @default(cuid())
  officeId                String
  office                  Office    @relation(fields: [officeId], references: [id], onDelete: Cascade)
  dayOfWeek               Int // 0=Sun, 1=Mon ... 6=Sat
  startTime               String // HH:mm — session opens & notification sent
  cutoffTime              String // HH:mm — requests close
  label                   String? // e.g. "Matin", "Après-midi"
  lastNotifiedDate        DateTime? @db.Date // idempotency: skip if already notified today
  lastNotifiedMessageTs   String? // Slack message ts, used to chat.update the live message when requests change
  lastNotifiedChannelId   String?
  cutoffNotifiedDate      DateTime? @db.Date
  cutoffNotifiedMessageTs String?
  cutoffNotifiedChannelId String?

  createdAt DateTime @default(now())

  dailyRequests DailyRequest[]

  @@unique([officeId, dayOfWeek, startTime])
  @@index([dayOfWeek])
}

model DailyRequest {
  id            String        @id @default(cuid())
  date          DateTime      @db.Date
  officeId      String
  office        Office        @relation(fields: [officeId], references: [id], onDelete: Cascade)
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  itemId        String
  item          Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  mateSessionId String?
  mateSession   MateSession?  @relation(fields: [mateSessionId], references: [id], onDelete: SetNull)
  status        RequestStatus @default(REQUESTED)
  createdAt     DateTime      @default(now())

  @@unique([date, officeId, userId, mateSessionId])
  @@index([itemId])
}

model Stock {
  officeId            String
  office              Office    @relation(fields: [officeId], references: [id], onDelete: Cascade)
  itemId              String
  item                Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  currentQty          Int       @default(0)
  updatedAt           DateTime  @updatedAt
  lowStockAlertSentAt DateTime?

  movements StockMovement[]

  @@id([officeId, itemId])
  @@index([itemId])
}

model StockMovement {
  id        String              @id @default(cuid())
  officeId  String
  itemId    String
  item      Item                @relation(fields: [itemId], references: [id], onDelete: Cascade)
  stock     Stock               @relation(fields: [officeId, itemId], references: [officeId, itemId], onDelete: Cascade)
  delta     Int // +N or -N
  reason    StockMovementReason
  note      String?
  userId    String?
  user      User?               @relation(fields: [userId], references: [id])
  createdAt DateTime            @default(now())

  @@index([officeId, itemId])
}

/// One physical count of the fridge: what was actually on the shelf versus what
/// the app believed. Each line with a non-zero delta emits an INVENTORY stock
/// movement, and the missing cans are billed as shrinkage on the period that
/// contains `countedAt`.
model StockCount {
  id              String    @id @default(cuid())
  officeId        String
  office          Office    @relation(fields: [officeId], references: [id], onDelete: Cascade)
  countedAt       DateTime  @default(now())
  countedByUserId String
  countedBy       User      @relation("CountedBy", fields: [countedByUserId], references: [id])
  note            String?
  createdAt       DateTime  @default(now())
  /// When the count was undone. A cancelled count is kept — it happened, and
  /// the stock movements that reversed it point back at it — but `@/lib/costing`
  /// skips its lines, so its shrinkage stops being billed to anybody.
  cancelledAt     DateTime?

  lines StockCountLine[]

  @@index([officeId, countedAt])
}

model StockCountLine {
  id          String     @id @default(cuid())
  countId     String
  count       StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  itemId      String
  item        Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  expectedQty Int
  countedQty  Int
  /// countedQty - expectedQty: negative is shrinkage, positive is a surplus.
  delta       Int

  @@index([countId])
}

/// A purchase order. Can span several item types via its `lines`; `totalPrice`
/// is the order total (sum of the line totals).
model PurchaseBatch {
  id              String         @id @default(cuid())
  officeId        String
  office          Office         @relation(fields: [officeId], references: [id], onDelete: Cascade)
  status          PurchaseStatus @default(ORDERED)
  purchasedAt     DateTime       @default(now())
  deliveredAt     DateTime?
  orderedByUserId String
  orderedBy       User           @relation("OrderedBy", fields: [orderedByUserId], references: [id])
  paidByUserId    String
  paidBy          User           @relation("PaidBy", fields: [paidByUserId], references: [id])
  totalPrice      Decimal        @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime       @default(now())

  lines              PurchaseLine[]
  invoices           InvoiceFile[]
  consumptionEntries ConsumptionEntry[]

  @@index([officeId])
}

/// A single item line within a purchase order.
model PurchaseLine {
  id        String        @id @default(cuid())
  batchId   String
  batch     PurchaseBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  itemId    String
  item      Item          @relation(fields: [itemId], references: [id], onDelete: Cascade)
  qty       Int
  unitPrice Decimal       @db.Decimal(10, 2)
  lineTotal Decimal       @db.Decimal(10, 2)

  @@index([batchId])
  @@index([itemId])
}

model InvoiceFile {
  id              String        @id @default(cuid())
  purchaseBatchId String
  purchaseBatch   PurchaseBatch @relation(fields: [purchaseBatchId], references: [id], onDelete: Cascade)
  storageKey      String
  filename        String
  mimeType        String
  uploadedAt      DateTime      @default(now())
}

model ConsumptionEntry {
  id              String            @id @default(cuid())
  officeId        String
  office          Office            @relation(fields: [officeId], references: [id], onDelete: Cascade)
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  itemId          String
  item            Item              @relation(fields: [itemId], references: [id], onDelete: Cascade)
  date            DateTime          @db.Date
  qty             Int               @default(1)
  source          ConsumptionSource @default(DAILY_REQUEST)
  purchaseBatchId String?
  purchaseBatch   PurchaseBatch?    @relation(fields: [purchaseBatchId], references: [id])
  /// Terminal that recorded the take, when there was one.
  deviceId        String?
  device          Device?           @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  deviceTakes     DeviceTake[]
  cancelledAt     DateTime?
  createdAt       DateTime          @default(now())

  @@index([officeId, itemId])
}

model ReimbursementPeriod {
  id               String    @id @default(cuid())
  officeId         String
  office           Office    @relation(fields: [officeId], references: [id], onDelete: Cascade)
  month            Int // 1-12
  year             Int // e.g. 2026
  startDate        DateTime  @db.Date
  endDate          DateTime  @db.Date
  createdAt        DateTime  @default(now())
  /// When each member was last emailed their own statement for this period.
  /// Null means never: both the monthly cron and the admin button read it
  /// before sending, so a re-run of either does not bill everybody twice by
  /// mail.
  statementsSentAt DateTime?

  lines      ReimbursementLine[]
  deliveries StatementDelivery[]

  @@unique([officeId, year, month])
}

/// One row per member actually mailed their statement for a period.
///
/// Its presence is what stops a retry from billing somebody twice, and its
/// absence is what lets a retry resume where the last attempt stopped — a
/// send that dies halfway (a timeout, a mail provider having a bad day) must
/// neither re-mail the people it reached nor abandon the ones it did not.
model StatementDelivery {
  periodId String
  period   ReimbursementPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  userId   String
  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Where it went, kept for the inevitable "I never got my bill".
  email    String
  sentAt   DateTime            @default(now())

  @@id([periodId, userId])
  @@index([periodId])
}

model ReimbursementLine {
  id         String              @id @default(cuid())
  periodId   String
  period     ReimbursementPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  fromUserId String
  fromUser   User                @relation("ReimbursementFrom", fields: [fromUserId], references: [id])
  toUserId   String
  toUser     User                @relation("ReimbursementTo", fields: [toUserId], references: [id])
  amount     Decimal             @db.Decimal(10, 2)
  currency   String              @default("CHF")
  status     PaymentStatus       @default(PENDING)
  paidAt     DateTime?

  // The unpaid-invoices banner queries this on every signed-in page render.
  @@index([fromUserId, status])
}

// ─── Bottle-flip game ───────────────────────────────────
//
// One row per player, totals since they first played. A landing is a throw
// that came to rest standing; the streak counts landings in a row.
model FlipScore {
  userId        String   @id
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  landings      Int      @default(0)
  throws        Int      @default(0)
  currentStreak Int      @default(0)
  bestStreak    Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([landings, bestStreak])
}

// ─── Badge terminals ─────────────────────────────────────

/// A badge terminal linked to an office. It authenticates with a bearer token;
/// only the token's SHA-256 is stored, so a database leak gives no access.
model Device {
  id         String  @id @default(cuid())
  officeId   String
  office     Office  @relation(fields: [officeId], references: [id], onDelete: Cascade)
  name       String
  /// Wi-Fi MAC address the terminal reported when it asked to be linked.
  hardwareId String
  tokenHash  String  @unique
  linkedById String?
  linkedBy   User?   @relation("DeviceLinkedBy", fields: [linkedById], references: [id], onDelete: SetNull)

  leftAction  DeviceKeyAction @default(TAKE)
  leftItemId  String?
  leftItem    Item?           @relation("DeviceLeftItem", fields: [leftItemId], references: [id], onDelete: SetNull)
  /// Text above the key; null derives it from the action and the item.
  leftLabel   String?
  rightAction DeviceKeyAction @default(RETURN)
  rightItemId String?
  rightItem   Item?           @relation("DeviceRightItem", fields: [rightItemId], references: [id], onDelete: SetNull)
  rightLabel  String?
  /// Local times ("HH:MM", office timezone) at which the terminal syncs.
  syncTimes   String[]        @default(["08:00", "12:00", "15:00", "18:00"])

  firmwareVersion String?
  batteryMv       Int?
  wifiRssi        Int?
  lastSeenAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  consumptionEntries ConsumptionEntry[]
  takes              DeviceTake[]

  @@index([officeId])
}

/// One key press confirmed by a badge on a terminal, as the terminal sent it.
/// A terminal resends its queue until the server acknowledges it, so
/// (deviceId, takeId) is unique and a replay changes nothing.
model DeviceTake {
  id                 String            @id @default(cuid())
  deviceId           String
  device             Device            @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// Id the terminal gave the take.
  takeId             String
  action             DeviceKeyAction
  badgeUid           String
  itemId             String?
  /// Null when the take was applied; otherwise why it was not.
  rejectedReason     String?
  consumptionEntryId String?
  consumptionEntry   ConsumptionEntry? @relation(fields: [consumptionEntryId], references: [id], onDelete: SetNull)
  takenAt            DateTime
  createdAt          DateTime          @default(now())

  @@unique([deviceId, takeId])
  @@index([deviceId, takenAt])
}

/// A pending link between a terminal and an office, after RFC 8628: the
/// terminal holds the secret device code, a signed-in admin approves the short
/// user code, and the terminal's next poll turns the approval into a `Device`.
model DeviceLink {
  id             String    @id @default(cuid())
  deviceCodeHash String    @unique
  /// Eight characters without look-alikes, shown on the terminal as XXXX-XXXX.
  userCode       String    @unique
  hardwareId     String
  expiresAt      DateTime
  lastPolledAt   DateTime?
  approvedAt     DateTime?
  deniedAt       DateTime?
  /// Set by the poll that hands the token over; a link is redeemed once.
  redeemedAt     DateTime?
  officeId       String?
  office         Office?   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  deviceName     String?
  approvedById   String?
  approvedBy     User?     @relation("DeviceLinkApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now())

  @@index([expiresAt])
}

/// A badge seen by a terminal. Unknown badges are recorded unassigned so an
/// admin can give them to a member without anyone typing an UID.
model Badge {
  id          String   @id @default(cuid())
  officeId    String
  office      Office   @relation(fields: [officeId], references: [id], onDelete: Cascade)
  /// Uppercase hex, no separators.
  uid         String
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([officeId, uid])
}
