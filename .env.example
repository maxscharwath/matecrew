# Database (plain Node only; on Cloudflare it is the D1 binding DB)
# A SQLite file (`bun run db:migrate:sqlite`) or a libSQL URL.
DATABASE_URL=file:.data/matecrew.sqlite

# Better Auth
BETTER_AUTH_SECRET=     # Generate with: openssl rand -base64 32
# Must be the exact public origin: it is published verbatim as the OAuth
# `issuer` for the MCP connector (/api/mcp), and MCP clients reject a mismatch.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Platform adapter set compiled in: node (default for `bun run dev`),
# cloudflare (`bun run dev:cf`, `bun run preview`) or vercel (the default
# when Vercel builds). See src/platform/README.md.
# PLATFORM=

# Uploaded files under plain Node (defaults to .data/storage). On Cloudflare
# they go to the R2 binding FILES declared in wrangler.jsonc.
# LOCAL_STORAGE_DIR=

# PLATFORM=vercel only: the Cloudflare Worker whose D1, R2 and Queue this
# deployment shares, through its platform bridge (src/platform/cloudflare/bridge),
# and the secret both sign with: the Worker's PLATFORM_BRIDGE_SECRET. It grants
# full database and file access, so treat it as a database credential.
# PLATFORM_BRIDGE_URL=https://matecrew.<subdomain>.workers.dev
# PLATFORM_BRIDGE_SECRET=

# Slack Bot (create app at api.slack.com/apps)
# Required OAuth scopes: chat:write, users:read, users:read.email
# For interactive buttons: enable Interactivity & Shortcuts with Request URL
#   https://YOUR_DOMAIN/api/slack/interactions
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=             # Basic Information → App Credentials → Signing Secret
SLACK_BOT_USERNAME=MateCrew
SLACK_BOT_ICON_URL=

# Resend (password reset emails — get API key at resend.com, verify your domain)
RESEND_API_KEY=
EMAIL_FROM=MateCrew <noreply@yourdomain.com>

# Microsoft SSO — fill to enable the SSO button on login/signup
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# Email domain aliases — domains belonging to the same company, so the same
# person on different domains is detected as one identity in Admin → Accounts.
# Groups separated by ";", domains within a group by ",". First domain is
# canonical. Defaults to "owt.swiss,openwt.com" when unset.
EMAIL_DOMAIN_ALIASES=owt.swiss,openwt.com

# Comma-separated email domains allowed to create an account (empty: any).
ALLOWED_EMAIL_DOMAINS=

# Set to "true" to disable email+password auth (forces SSO-only).
# Hides the email/password forms, the "forgot password" link, and the
# /forgot-password and /reset-password pages.
DISABLE_PASSWORD_AUTH=

# Optional downloadable TSX app served from device/dist (requires firmware 0.3.0 and the rebuilt Wasm).
# DEVICE_UI_APP=hello
# DEVICE_UI_APP=showcase

# Device theme: paper (default, the native kit), dark (paper inverted), or the older flipper / macos.
# Rendering remains on device.
# DEVICE_UI_THEME=paper
