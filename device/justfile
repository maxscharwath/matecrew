# Run from device/. `just --list` shows every recipe.

esp := ". ~/export-esp.sh &&"
version := `grep -m1 '^version' firmware/Cargo.toml | cut -d'"' -f2`
# Files the local site serves (images, firmware), kept apart from the copy of production.
storage := "STORAGE_PROVIDER=local LOCAL_STORAGE_DIR=.data/dev-storage"

default:
    @just --list

# Install the ESP32-S3 Rust toolchain and the flashing tools.
setup:
    brew install espflash just
    cargo install espup ldproxy cargo-watch --locked
    espup install --targets esp32s3

# Redraw every screen to sim/out/*.png on each save.
sim:
    cd sim && cargo watch -q -w ../ui -w src -x run

# Unit tests that run on the Mac.
test:
    cd core && cargo test
    cd ui && cargo test
    cd web && cargo test

# Build the virtual device's wasm into the site (public/device/matecrew.wasm).
web:
    cd web && cargo build --release --target wasm32-unknown-unknown
    cp "$(cd web && cargo metadata --format-version 1 --no-deps | python3 -c 'import json,sys; print(json.load(sys.stdin)["target_directory"])')/wasm32-unknown-unknown/release/matecrew_web.wasm" ../public/device/matecrew.wasm

# Rebuild the wasm on every save in core, ui or web; the virtual device in `just api` reloads it by itself.
web-watch:
    cd web && cargo watch -q -w ../core -w ../ui -w src -s "cd .. && just web"

# Build, flash the XIAO over USB and open the serial monitor. Setup proposes matecrew.vercel.app.
flash:
    cd firmware && {{esp}} cargo build && ./flash.sh --monitor

# Same, but setup proposes the site running on this Mac (`just api`).
flash-local:
    cd firmware && {{esp}} MATECREW_URL=http://$(ipconfig getifaddr en0):3000 cargo build && ./flash.sh --monitor

# Build the application image for an update over the network: release/matecrew-<version>.bin.
release:
    cd firmware && {{esp}} cargo build
    mkdir -p release
    espflash save-image --chip esp32s3 "$(cd firmware && cargo metadata --format-version 1 --no-deps | python3 -c 'import json,sys; print(json.load(sys.stdin)["target_directory"])')/xtensa-esp32s3-espidf/debug/matecrew-device" release/matecrew-{{version}}.bin

# Publish that image on the local copy of production (scripts/dev-prod-copy.sh): terminals install it at their next sync.
publish:
    cd .. && url=$(sed -n 's/^DATABASE_URL=//p' .env.local | tr -d '"' | sed -E 's#/[^/?]+(\?|$)#/matecrew_prod\1#') && DATABASE_URL="$url" DIRECT_URL="$url" STORAGE_PROVIDER=local LOCAL_STORAGE_DIR=.data/storage bun scripts/publish-firmware.ts device/release/matecrew-{{version}}.bin

# Forget the Wi-Fi, the token and the screen: the device starts setup again.
forget:
    espflash erase-region 0x9000 0x6000

# Build the firmware without flashing.
build:
    cd firmware && {{esp}} cargo build

# Run the matécrew site locally for the device to talk to.
api:
    cd .. && {{storage}} bun dev --hostname 0.0.0.0
