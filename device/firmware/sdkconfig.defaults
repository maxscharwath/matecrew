# Nested TSX scenes and the system overlay share the main render task.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
# The screen loop runs on core 1, away from Wi-Fi and lwIP on core 0 (src/cores.rs).
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
# Drawing an app screen takes 250 to 420 ms at 160 MHz: a third less at 240.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
# The XIAO ESP32-S3 has 8 MB of octal PSRAM. Buffers, scenes, JSON and Wi-Fi go there; about
# 180 KB of internal RAM stays free for task stacks, DMA, timers and USB (it was under 40 KB, and
# the Wi-Fi then failed its own timers). Without the PSRAM the terminal still boots, on internal
# RAM only.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_USE_MALLOC=y
# Only tiny allocations stay internal: JSON nodes, strings and layout vectors (thousands of
# small ones) go to PSRAM. Allocations that must be internal (DMA, FreeRTOS, ISR) ask for it.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=64
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
# Wi-Fi and lwIP buffers and mbedTLS sessions in PSRAM: with them in internal RAM the terminal had
# under 40 KB left once online, and a peak (a frame upload during a sync) failed the Wi-Fi's own
# timers with ESP_ERR_NO_MEM. Internal RAM stays for task stacks, DMA and timers.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
# An updated firmware that does not sync before its first restart is rolled
# back by the bootloader (src/ota.rs). Flash this build's bootloader, not
# espflash's: `just flash` does.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
